# ==============================================================================
# DECOLAR CONSÓRCIOS — CONFIGURAÇÃO APACHE / LITESPEED (.htaccess)
# ==============================================================================

# 1. SEGURANÇA E DIRETÓRIOS
# Desativa listagem de arquivos de diretórios não mapeados
Options -Indexes

# Bloqueia acesso a arquivos sensíveis, scripts SQL, backups e configurações
<FilesMatch "\.(env|sql|bak|old|tmp|log|git|md|yml|yaml|toml|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Cabeçalhos de proteção e segurança HTTP
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 2. MOTOR DE REESCRITA (REWRITES E REDIRECTS 301)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Regra A: Redirecionar /index ou /index.html para a raiz / (HTTP 301 permanente)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(?:\.html)?[\s?] [NC]
    RewriteRule ^index(?:\.html)?$ / [R=301,L,NE]

    # Regra B: Redirecionar qualquer requisição externa explícita com .html para a URL limpa (HTTP 301)
    # Usa %{THE_REQUEST} para disparar APENAS em requisições diretas do navegador/bot,
    # prevenindo qualquer loop de redirecionamento infinito com a regra de rewrite interno.
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.?\s]+)\.html[\s?] [NC]
    RewriteRule ^ %1 [R=301,L,NE]

    # Regra C: Se o caminho solicitado for um arquivo ou pasta física real, serve diretamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Regra D: Rewrite interno de URL limpa para arquivo .html correspondente (HTTP 200 silencioso)
    # Preserva parâmetros de consulta (como ?modalidade=... no simulador) através da flag QSA
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L,QSA]

    # Regra D (fallback para caminhos relativos ao diretório atual)
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L,QSA]
</IfModule>

# 3. MIME TYPES E COMPRESSÃO
<IfModule mod_mime.c>
    AddType text/html .html
    AddType text/css .css
    AddType application/javascript .js
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType application/xml .xml
</IfModule>
